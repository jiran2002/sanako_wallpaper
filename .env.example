# ===== 服务配置 =====
PORT=8080
HOST=0.0.0.0
# 对外访问地址（用于拼接本地存储图片的绝对地址），生产环境请改成你的域名
PUBLIC_BASE_URL=http://localhost:8080

# ===== 安全 =====
# JWT 签名密钥，部署前务必改成随机字符串
JWT_SECRET=please-change-this-to-a-random-string
# 初始管理员账号（仅首次启动、数据库中无管理员时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 数据库 =====
# SQLite 数据库文件路径（相对 server/ 目录或绝对路径）
DB_FILE=data/app.db

# ===== 本机存储 =====
# 本机存储的图片目录（相对 server/ 目录或绝对路径）
LOCAL_STORAGE_DIR=data/uploads
# 本机存储的公开访问前缀
LOCAL_PUBLIC_URL=/uploads

# ===== 存储源默认值 =====
# 后台可在「存储设置」中随时切换：local | s3 | r2
STORAGE_DRIVER=local
# 账号池选择策略：round_robin | random | least_used
STORAGE_STRATEGY=round_robin
